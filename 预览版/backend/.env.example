# 复制为 .env 并填入真实值
# LLM Provider（OpenAI 兼容格式，任选一家，填 key 后 AI 能力全开）：
# 1) 智谱 GLM-4-Flash（完全免费）：
#    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/  LLM_MODEL=glm-4-flash
# 2) 硅基流动（注册送 14 元，可用 Qwen3.5 等）：
#    LLM_BASE_URL=https://api.siliconflow.cn/v1  LLM_MODEL=Qwen/Qwen3.5-122B-A10B
# 3) DeepSeek（默认）：
#    LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 数据目录（SQLite + ChromaDB + 图片）
DATA_DIR=./data
# 向量模型（可选，未安装 sentence-transformers 时忽略）
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5

# Mathpix 数学 OCR（可选，填了参与交叉验证；不填自动跳过）
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
